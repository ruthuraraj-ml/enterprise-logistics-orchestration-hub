# ==============================================================================
# PROJECT SPECIFIC PERSISTENT STORES & DATABASES
# ==============================================================================
# Ignores your local SQLite databases generated by the StrategyMemory engine
*.db
*.sqlite
*.sqlite3

# Ignore the physical data directory containing raw CSV datasets
old files/

# ==============================================================================
# PYTHON RUNTIME ENVIRONMENT & CACHES
# ==============================================================================
# Virtual environment folders
.venv/
venv/
ENV/
env/

# Python bytecode caching layers
__pycache__/
*.py[cod]
*$py.class

# Distribution, packaging, and build directories
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# CREWAI & AGENTIC WORKFLOW TEMPORARIES
# ==============================================================================
# Ignore local multi-agent telemetry or framework-specific caching layers
.crewai/

# ==============================================================================
# CONFIGURATIONS & ENVIRONMENT CREDS
# ==============================================================================
# API secrets, encryption tokens, and local deployment flags
.env
.env.*
!.env.example

# ==============================================================================
# IDE WORKSPACE FILTERS (VS CODE / PYCHARM)
# ==============================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp